---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isLocale, locales, useTranslations } from "../../i18n";

export async function getStaticPaths() {
  const entries = await getCollection("legal");
  const docs = new Set(entries.map((entry) => entry.id.split("/").slice(1).join("/")));

  for (const doc of docs) {
    for (const locale of locales) {
      if (!entries.some((entry) => entry.id === `${locale}/${doc}`)) {
        throw new Error(`Missing "${locale}" translation of legal doc "${doc}"`);
      }
    }
  }

  return entries.map((entry) => {
    const [lang, ...rest] = entry.id.split("/");
    if (!isLocale(lang)) throw new Error(`Legal doc "${entry.id}" is not under a supported locale folder`);
    return { params: { lang, doc: rest.join("/") }, props: { entry, locale: lang } };
  });
}

const { entry, locale } = Astro.props;
const { doc } = Astro.params;
const t = useTranslations(locale);
const { Content } = await render(entry);
const updated = new Intl.DateTimeFormat(locale, { dateStyle: "long", timeZone: "UTC" }).format(entry.data.updated);
---

<BaseLayout locale={locale} path={doc} title={entry.data.title} description={entry.data.description}>
  <article class="prose">
    <h1>{entry.data.title}</h1>
    <p class="updated">{t("privacy.updated", { date: updated })}</p>
    <Content />
  </article>
</BaseLayout>

<style>
  .updated {
    color: var(--color-on-surface-variant);
    font-size: 0.95rem;
  }
</style>

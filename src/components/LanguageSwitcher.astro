---
import { localeNames, localePath, locales, useTranslations, type Locale } from "../i18n";

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const t = useTranslations(locale);
---

<nav class="switcher" aria-label={t("nav.language")}>
  {
    locales.map((l) =>
      l === locale ? (
        <span aria-current="true" lang={l}>
          {localeNames[l]}
        </span>
      ) : (
        <a href={localePath(l, path)} hreflang={l} lang={l} data-locale-switch={l}>
          {localeNames[l]}
        </a>
      ),
    )
  }
</nav>

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-locale-switch]")) {
    link.addEventListener("click", () => {
      link.search = location.search;
      try {
        localStorage.setItem("locale", link.dataset.localeSwitch ?? "");
      } catch {}
    });
  }
</script>

<style>
  .switcher {
    display: flex;
    gap: 0.25rem;
    font-size: 0.9rem;
  }

  .switcher > * {
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
  }

  .switcher span {
    background: var(--color-primary-container);
    color: var(--color-on-primary-container);
    font-weight: 600;
  }

  .switcher a {
    color: var(--color-on-surface-variant);
    text-decoration: none;
  }

  .switcher a:hover {
    color: var(--color-on-surface);
    background: var(--color-surface-container);
  }
</style>

---
interface Props {
  size?: number;
}

const { size = 32 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 108 108" aria-hidden="true" focusable="false">
  <rect width="108" height="108" rx="24" fill="#8BBCE0"></rect>
  <path
    d="M72.5 40.5A22.5 22.5 0 1 0 54 76.5H68.5"
    fill="none"
    stroke="#0E1215"
    stroke-width="12"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
